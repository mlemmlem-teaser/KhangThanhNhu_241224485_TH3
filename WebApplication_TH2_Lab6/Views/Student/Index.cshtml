@model IEnumerable<Student>
@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
<br/>
<br/>
<br/>
<div class="container-fluid px-4">
    <a asp-action="Create" class="btn btn-primary">Create Student</a>
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ ĐT</th>
                <th>Điểm</th>
                <th>Địa chỉ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                    <td>@Html.DisplayFor(m => item.Branch)</td>
                    <td>@Html.DisplayFor(m => item.Gender)</td>
                    <td>@(item.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                    <td>@item.Score</td>
                    <td>@item.Address</td>
                </tr>
            }
        </tbody>
    </table>
</div>
